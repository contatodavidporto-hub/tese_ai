# Copie para .env e preencha. NUNCA commite o .env (está no .gitignore).

# App
APP_ENV=development
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Banco — Supabase Postgres (projeto tese-ai). Copie o "Session pooler" URI EXATO
# em: Project > Connect > Session pooler (traz o host correto + a sua senha do banco).
# Formato: postgresql+psycopg://postgres.rjpqaaymwhcwxtinppvc:<SENHA-DO-BANCO>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase (valores PÚBLICOS — seguros no cliente; protegidos por RLS)
SUPABASE_URL=https://rjpqaaymwhcwxtinppvc.supabase.co
SUPABASE_ANON_KEY=sb_publishable_nruI7x_X2RDmBHRjzobCrA_R15FV_EC
# SEGREDO — somente backend. Nunca expor ao frontend (sem NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# --- Portaria (contas + RLS enforçada, missão 2026-07-27) --------------------
# Lane de RLS ENFORÇADA: conexão do role de login `app_backend` (LOGIN, NOINHERIT,
# NOBYPASSRLS). O backend faz SET LOCAL ROLE authenticated|anon|app_worker + claims
# por transação. Crie o role e a senha no SQL editor do dashboard (out-of-band) e
# faça o preflight `psql` do login contra o pooler ANTES do cutover. Em branco, a
# lane de RLS fica indisponível e o caminho segue no DATABASE_URL (postgres).
# Formato: postgresql+psycopg://app_backend.rjpqaaymwhcwxtinppvc:<SENHA>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL_RLS=
# Segredo do perímetro X-Portaria (Vercel↔Railway). MESMO valor no frontend (Vercel).
# FAIL-CLOSED: em APP_ENV=production, ausente => a app NÃO sobe. Gere com `openssl rand -hex 32`.
PORTARIA_SECRET=

# LLM (Anthropic) — usado a partir do Estágio 1B
ANTHROPIC_API_KEY=

# Consenso (Haiku + web_search): GASTA LLM — autorização expressa (LLM06). Desligado
# por padrão; ligue por env em produção (runbook A10). NÃO entra no teto de custo (P1).
CONSENSO_ENABLED=false

# Observabilidade (Langfuse) — opcional; cliente vira no-op se em branco
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Rate-limit distribuído — opcional. Com REDIS_URL o slowapi usa Redis como
# storage (bucket compartilhado entre instâncias/workers); em branco, memória do
# processo. Produção: prefira rediss:// (TLS). Ex.: rediss://default:<senha>@host:6380/0
REDIS_URL=

# Scheduler in-app (jobs de manutenção; cadência por ledger job_runs no banco).
# SCHEDULER_ENABLED=false desliga tudo; intervalo 0 desliga o job individual.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
SCHEDULER_REAPER_MIN=15
SCHEDULER_MACRO_HORAS=24
SCHEDULER_CADASTRO_HORAS=168
# Warm-cache da galeria (top-10 IBOV). GASTA LLM quando o cache expirou:
# lote frio ~US$ 2,70/dia (teto TESE_TETO_CUSTO_USD_DIA aplica). 0 desliga.
SCHEDULER_WARM_CACHE_HORAS=24

# Conectores premium behind-config (opcionais; keyless segue sem eles)
FRED_API_KEY=
EIA_API_KEY=

# Qualidade de dados: idade máxima (meses) de fundamento de par SEC como "atual"
PARES_MAX_IDADE_MESES=24

# Teto de custo de LLM por dia (USD, GLOBAL, por processo). Default no código = 25.0.
TESE_TETO_CUSTO_USD_DIA=25.0
# Orçamento de custo de LLM POR USUÁRIO/dia (USD; LLM-COST-01, Onda 4). Esgotar o teto
# de UM usuário abstém só ele; os demais seguem gerando. 0 desliga. Default no código = 5.0.
TESE_TETO_CUSTO_USD_DIA_POR_USUARIO=5.0

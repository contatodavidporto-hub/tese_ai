# Copie para .env.local (gitignored). Todas SERVER-ONLY: SEM prefixo NEXT_PUBLIC_.
# Nenhuma pode ir ao bundle do cliente — a CSP `connect-src 'self'` + `import
# "server-only"` garantem que a auth e a URL do backend vivem só no servidor Next.
# ⚠ NÃO recrie um client Supabase no navegador (NEXT_PUBLIC_SUPABASE_*): furaria o
#   modelo BFF que esta camada inteira existe para proteger. NUNCA a service_role aqui.

# Backend FastAPI (proxy /api/teses -> este host). Em dev, default http://localhost:8000.
API_URL=http://localhost:8000

# Supabase Auth (missão "A Portaria"): o Next fala com o GoTrue server-side via
# @supabase/ssr. Chave PÚBLICA (publishable/anon) — segura server-side, protegida por
# RLS. Aceita SUPABASE_PUBLISHABLE_KEY ou SUPABASE_ANON_KEY.
SUPABASE_URL=https://rjpqaaymwhcwxtinppvc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_nruI7x_X2RDmBHRjzobCrA_R15FV_EC

# Perímetro X-Portaria (Vercel↔Railway): MESMO valor do PORTARIA_SECRET do backend.
# Assina toda chamada Next->FastAPI; sem ele, o backend em produção recusa (fail-closed).
PORTARIA_SECRET=

# Base absoluta p/ og:image/canonical (server-only). Fallback = domínio público.
SITE_URL=https://tese-ai.vercel.app
